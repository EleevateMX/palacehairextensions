{
  "name": "palace-os",
  "private": true,
  "version": "0.1.0",
  "description": "Palace Hair Extensions OS — plataforma de gestión integral del salón",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @palace/web dev",
    "build": "pnpm --filter @palace/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @palace/domain test",
    "test:db": "bash scripts/db-test.sh",
    "test:all": "pnpm test && pnpm test:db"
  }
}
