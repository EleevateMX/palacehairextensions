# Copiar a .env.local. Usar un proyecto Supabase EXCLUSIVO de Palace (nunca el de Shakeaholic u Hojaldras Lily).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar
# Solo servidor (portal público V2, webhooks). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_ENV=development
